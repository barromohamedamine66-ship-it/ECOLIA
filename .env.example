# ====================================================================
# ÉCOLIA SaaS - Configuration des Variables d'Environnement
# ====================================================================

# 1. Configuration Supabase Publique (Requise pour le client web)
# Obtenez ces clés dans Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_cle_anon_publique

# 2. Environnement de l'Application ('development' ou 'production')
NEXT_PUBLIC_APP_ENV=production

# 3. Paramètres Métier et Identité
NEXT_PUBLIC_APP_NAME="ÉCOLIA"
NEXT_PUBLIC_APP_TAGLINE="L'école, simplement."
NEXT_PUBLIC_DEFAULT_CURRENCY="FCFA"
NEXT_PUBLIC_DEFAULT_COUNTRY="Côte d'Ivoire"

# 4. Mode Démonstration (strictement ignoré en production)
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# ====================================================================
# ⚠️ AVERTISSEMENT SÉCURITÉ CRITIQUE :
# Ne JAMAIS ajouter SUPABASE_SERVICE_ROLE_KEY avec le préfixe NEXT_PUBLIC_ !
# La clé service_role bypass toutes les règles RLS et ne doit résider que
# sur des fonctions backend sécurisées (Edge Functions / API Routes privées).
# ====================================================================

